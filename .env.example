# Twitch (obligatorio)
TWITCH_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_BOT_USERNAME=
TWITCH_CHANNEL_NAME=

# Usuarios adicionales autorizados, separados por comas
AUTHORIZED_USERS=

# Playlist de YouTube (opcional; completar el bloque entero)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
PLAYLIST_ID=

# En Render se recomienda guardar el contenido de youtube_token.json aquí
YOUTUBE_TOKEN_JSON=

# Gemini (opcional)
GEMINI_API_KEY=

# Ajustes
MIN_BITS_SONG=200
PORT=3000

# Enlace opcional para Resident Evil 4. Generar un secreto largo y distinto
# del token de Twitch; también se configura en el puente local del streamer.
RE4_LINK_TOKEN=
